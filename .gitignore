# Index régénérable : la source de vérité est patterns/ et systems/.
patterns.db
# Preuves de rendu : régénérables par bin/render.mjs, et binaires (cf. la doctrine
# claude-config : pas de poids binaire dans l'historique).
proofs/
.render-*.html
.DS_Store
.slides-*.html
.board-*.html
.fonttest.html
# Bytecode Python du kit .pptx
kit/__pycache__/
assets/photos/**/*.jpg
assets/photos/**/*.png
assets/photos/**/board.html

# Images sources des reverses : binaires, et ce sont des visuels TIERS.
assets/refs/
# Temporaires des sondes, écrits à la RACINE sous un nom prévisible : un contrôle interrompu
# en laisse un derrière lui, et il finit dans un `git add` distrait.
.check-*.html
.frame-probe-*.html
.avg-1px-*.png
.contact-sheet*.html
.deckprobe-*.html
.diff-*.html
.palette-*.png
