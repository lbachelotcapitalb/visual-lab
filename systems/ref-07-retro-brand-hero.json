  "type": {
    "display": "Archivo, \"Archivo Black\", Impact, sans-serif",
    "body": "Archivo, Inter, -apple-system, \"Helvetica Neue\", Arial, sans-serif",
    "scale": {
      "wordmark": "148px / 0.82 / 900 / -0.01em",
      "logo": "22px / 1 / 900",
      "nav": "13px / 1 / 500",
      "button": "12px / 1 / 700 / 0.06em",
      "baseline": "11px / 1 / 400 italic"
    }
